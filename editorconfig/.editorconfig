# =============================================================================
# EditorConfig — consistent formatting across editors
# https://editorconfig.org
# =============================================================================

root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.md]
trim_trailing_whitespace = false

# Preserve ecosystem-standard indentation where two spaces would be incorrect.
[*.{py,pyi}]
indent_size = 4

[*.go]
indent_style = tab
indent_size = tab
tab_width = 8

[*.{cs,fs,fsi,fsx,java,rs,vb}]
indent_size = 4

[Makefile]
indent_style = tab
indent_size = tab
tab_width = 8

[*.{yml,yaml}]
indent_size = 2

[*.{sh,zsh}]
indent_size = 2

[*.{json,jsonc}]
indent_size = 2

[*.toml]
indent_size = 2

{
  // --- Appearance (GitHub Dark) ---
  "workbench.colorTheme": "GitHub Dark",
  "workbench.iconTheme": "material-icon-theme",

  // --- Minimalism (Zen Mode by default) ---
  "editor.minimap.enabled": false,
  "workbench.activityBar.location": "default",
  "workbench.statusBar.visible": true,
  "editor.scrollbar.vertical": "hidden",
  "editor.scrollbar.horizontal": "hidden",
  "window.menuBarVisibility": "toggle",
  "workbench.sideBar.location": "right",
  "editor.glyphMargin": false,
  "editor.folding": false,
  "editor.lineNumbers": "on",
  "editor.renderLineHighlight": "none",
  "workbench.layoutControl.enabled": false,
  "breadcrumbs.enabled": false,

  // --- Typography ---
  "editor.fontFamily": "'MesloLGS Nerd Font', 'JetBrains Mono', monospace",
  "editor.fontSize": 14,
  "editor.fontLigatures": true,
  "editor.lineHeight": 1.6,
  "editor.letterSpacing": 0.5,

  // --- Performance & Snappiness ---
  "editor.cursorBlinking": "solid",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.smoothScrolling": true,
  "workbench.list.smoothScrolling": true,
  "editor.multiCursorModifier": "alt",
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit",
    "source.organizeImports": "explicit",
  },

  // --- Language Specifics ---
  "[typescript]": {
    "editor.defaultFormatter": "vscode.typescript-language-features",
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "vscode.typescript-language-features",
  },
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.tabSize": 4,
  },
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer",
    "editor.tabSize": 4,
  },
  "[go]": {
    "editor.defaultFormatter": "golang.go",
    "editor.insertSpaces": false,
    "editor.tabSize": 8,
  },
  "[csharp]": {
    "editor.tabSize": 4,
  },
  "[makefile]": {
    "editor.insertSpaces": false,
    "editor.tabSize": 8,
  },

  // --- Terminal ---
  "terminal.integrated.fontFamily": "MesloLGS Nerd Font",
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.gpuAcceleration": "on",

  // --- Files & Security ---
  "files.autoSave": "onFocusChange",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "git.autofetch": true,
  "git.confirmSync": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.confirmDelete": false,

  // --- Extensions ---
  "extensions.autoCheckUpdates": false,
  "extensions.autoUpdate": "off",
  "extensions.ignoreRecommendations": true,
  "microsoft-authentication.implementation": "msal-no-broker",
  "projectManager.git.baseFolders": ["~/GitHub"],
  "settingsSync.ignoredExtensions": ["typescriptteam.native-preview"],
  "todo-tree.ripgrep.ripgrep": "__DOTFILES_RIPGREP__",
  "workbench.startupEditor": "none"
}

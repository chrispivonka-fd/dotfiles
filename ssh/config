# Local entries come first because OpenSSH uses the first value obtained for
# most settings. This lets machine-specific hosts override shared defaults.
Include ~/.ssh/config.local
Include ~/.colima/ssh_config

Host github.com
  HostName github.com
  User git
  PreferredAuthentications publickey

Host *
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"

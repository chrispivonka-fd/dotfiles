#!/usr/bin/env bash
# Enforce Conventional Commits globally while preserving Git-generated merge,
# revert, and autosquash messages.
set -euo pipefail

HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
# shellcheck source=lib/common.sh
source "$HOOK_DIR/lib/common.sh"

msg_file="$1"
message="$(git stripspace --strip-comments < "$msg_file")"

if [ -z "$message" ]; then
    hook_error "commit message cannot be empty"
    exit 1
fi

secret_pattern='(AKIA[0-9A-Z]{16}|github_pat_[A-Za-z0-9_]{20,}|gh[pousr]_[A-Za-z0-9]{20,}|xox[baprs]-[0-9A-Za-z-]+|sk-[A-Za-z0-9_-]{20,}|op://[^[:space:]]+|-----BEGIN [A-Z ]*PRIVATE KEY-----)'
if printf '%s\n' "$message" | grep -qE "$secret_pattern"; then
    hook_error "commit message appears to contain a secret or secret reference"
    exit 1
fi

header="${message%%$'\n'*}"

case "$header" in
    "Merge "*|"Revert \""*|"fixup! "*|"squash! "*|"amend! "*)
        run_local_hook commit-msg "$@"
        exit 0
        ;;
esac

conventional_pattern='^(build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test)(\([a-z0-9][a-z0-9._/-]*\))?(!)?: [^[:space:]].*$'
if [[ ! "$header" =~ $conventional_pattern ]]; then
    hook_error "commit header must follow Conventional Commits"
    printf '%s\n' \
        "  expected: type(scope): concise description" \
        "  types: build, chore, ci, docs, feat, fix, perf, refactor, revert, style, test" \
        "  breaking: feat(api)!: remove deprecated endpoint" >&2
    exit 1
fi

if [ "${#header}" -gt 100 ]; then
    hook_error "commit header exceeds 100 characters"
    exit 1
fi

if [[ "$header" == *[[:space:]] ]]; then
    hook_error "commit header cannot end with whitespace"
    exit 1
fi

if [[ "$message" == *$'\n'* ]]; then
    remainder="${message#*$'\n'}"
    second_line="${remainder%%$'\n'*}"
    if [ -n "$second_line" ]; then
        hook_error "separate the commit header and body with a blank line"
        exit 1
    fi
fi

run_local_hook commit-msg "$@"

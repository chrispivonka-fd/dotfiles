#!/usr/bin/env bash
# Non-blocking dependency reminders after a successful merge or pull.
set -euo pipefail

HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
# shellcheck source=git/hooks/lib/common.sh
source "$HOOK_DIR/lib/common.sh"

changed="$(git diff-tree -r --name-only --no-commit-id ORIG_HEAD HEAD 2>/dev/null || true)"
node_changed=0
python_changed=0
dotnet_changed=0
go_changed=0
rust_changed=0
mise_changed=0
terraform_changed=0

while IFS= read -r file; do
  [ -n "$file" ] || continue
  basename="${file##*/}"
  case "$basename" in
    package.json|package-lock.json|pnpm-lock.yaml|yarn.lock|bun.lock|bun.lockb)
      node_changed=1 ;;
    pyproject.toml|uv.lock|requirements*.txt)
      python_changed=1 ;;
    global.json|Directory.Packages.props|*.sln|*.csproj|*.fsproj|dotnet-tools.json)
      dotnet_changed=1 ;;
    go.mod|go.sum)
      go_changed=1 ;;
    Cargo.toml|Cargo.lock)
      rust_changed=1 ;;
    mise.toml|mise.lock|.mise.toml)
      mise_changed=1 ;;
    .terraform.lock.hcl)
      terraform_changed=1 ;;
  esac
done <<< "$changed"

if (( node_changed )); then hook_info "JavaScript dependencies changed; run the repository's package-manager install"; fi
if (( python_changed )); then hook_info "Python dependencies changed; run uv sync or the repository's install command"; fi
if (( dotnet_changed )); then hook_info ".NET dependencies or tools changed; run dotnet restore and dotnet tool restore"; fi
if (( go_changed )); then hook_info "Go dependencies changed; run go mod download"; fi
if (( rust_changed )); then hook_info "Rust dependencies changed; run cargo build"; fi
if (( mise_changed )); then hook_info "Mise configuration changed; run mise install"; fi
if (( terraform_changed )); then hook_info "Terraform providers changed; run terraform init"; fi

run_local_hook post-merge "$@"
exit 0

#!/usr/bin/env bash
# =============================================================================
# Renders aws/config.tpl -> ~/.aws/config, substituting op:// references via
# the 1Password CLI. Run manually whenever the template or the 1Password
# item it references changes. Requires `op` signed in (run `op signin` first
# if this fails with an auth error).
# =============================================================================
set -euo pipefail

DOTFILES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if ! command -v op &>/dev/null; then
    echo "[err] 1Password CLI (op) not found. Install it: brew install 1password-cli" >&2
    exit 1
fi

mkdir -p "$HOME/.aws"
op inject -i "$DOTFILES_DIR/aws/config.tpl" -o "$HOME/.aws/config" -f
chmod 600 "$HOME/.aws/config"
echo "Rendered ~/.aws/config from aws/config.tpl"

#!/usr/bin/env bash
# Resolves 1Password's macOS SSH-signing helper so git/.gitconfig can use a
# stable command name instead of an application-bundle path.
set -euo pipefail

candidates=(
    "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"
)

for path in "${candidates[@]}"; do
    if [ -x "$path" ]; then
        exec "$path" "$@"
    fi
done

echo "op-ssh-sign: not found — is the 1Password desktop app installed?" >&2
exit 1
